FROM registry.ci.openshift.org/ocp/5.0:base-rhel10
ARG RHEL_VERSION=''
# If RHEL_VERSION is empty, we infer it from the /etc/os-release file. This is used by OKD as we always want the latest one.
RUN [ "${RHEL_VERSION}" == "" ] && source /etc/os-release && RHEL_VERSION=${VERSION_ID}; echo ${RHEL_VERSION} > /etc/dnf/vars/releasever \
    && echo -e "best=True\ninstall_weak_deps=False" >> /etc/dnf/dnf.conf

# Kernel packages (kernel-devel, kernel-headers, kernel-modules[-extra],
# kernel-rt-*/kernel-64k-*, kernel-devel-matched, kernel-rpm-macros) are
# intentionally NOT installed here. They must match the exact RHCOS kernel
# for the target cluster, which isn't known at DTK build time. Instead,
# scripts/dtk-install-kernel-packages.sh is shipped in this image and is run
# at container runtime (via nested podman) once the target
# rhel-coreos-extensions/rhel-coreos-10-extensions image is known - see the
# script header for usage.
RUN dnf -y install podman jq

# Additional packages that are mandatory for driver-containers
RUN dnf -y install autoconf automake binutils elfutils-libelf-devel glibc kabi-dw kmod libtool

# Generic GCC toolchain. This is no longer version-matched to a specific
# kernel's build compiler at image-build time, since no kernel is installed
# yet - kernel-devel is only installed at container runtime, once the
# target RHCOS kernel is known (see dtk-install-kernel-packages.sh).
RUN dnf -y install gcc gcc-c++

# Additional packages that are needed for a subset (e.g DPDK) of driver-containers
RUN dnf -y install xz diffutils flex bison

# Packages needed to build driver-containers
RUN dnf -y install git make rpm-build

# Packages needed to sign and run externally build kernel modules
RUN if [ $(arch) == "x86_64" ] || [ $(arch) == "aarch64" ]; then \
    ARCH_DEP_PKGS="mokutil"; fi \
    && dnf -y install openssl keyutils $ARCH_DEP_PKGS

RUN dnf clean all && rm -rf /var/cache/dnf/*

COPY scripts/dtk-install-kernel-packages.sh /usr/local/bin/dtk-install-kernel-packages.sh
RUN chmod +x /usr/local/bin/dtk-install-kernel-packages.sh

COPY manifests/01-openshift-imagestream-rhel10.yaml /manifests/01-openshift-imagestream.yaml
COPY manifests/image-references-rhel10 /manifests/image-references

LABEL io.k8s.description="driver-toolkit is a container with the kernel packages necessary for building driver containers for deploying kernel modules/drivers on OpenShift" \
      name="driver-toolkit-10" \
      io.openshift.release.operator=true \
      version="0.1" \
      io.openshift.os.streamclass=rhel-10
